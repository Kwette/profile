{% set study = selectedWork.featured.caseStudy %}
{% from "components/technology-groups.njk" import technologyGroups %}
{% from "components/result-summary.njk" import resultSummary %}
{% from "components/case-study-source.njk" import caseStudySource %}
{% from "components/context-panels.njk" import contextPanels %}
{% from "components/product-workflow.njk" import productWorkflow %}
{% call caseStudySource("drime-editor-case-study-" ~ language, experiences.summaries.drime.logo, study, study.role ~ " · " ~ study.meta, experiences.dialog) %}
      <section data-case-study-panel>
        <div class="dialog-content-rail">
        <p class="project-case-study-intro">{{ study.intro }}</p>
        <figure class="project-case-study-media">
          {% if study.video.src %}
          <video src="{{ study.video.src }}" controls preload="metadata" poster="{{ selectedWork.featured.image.src }}" aria-label="{{ study.video.label }}"></video>
          {% else %}
          <img src="{{ selectedWork.featured.image.src }}" width="{{ selectedWork.featured.image.width }}" height="{{ selectedWork.featured.image.height }}" alt="{{ selectedWork.featured.image.alt }}">
          <figcaption>{{ study.video.pendingLabel }}</figcaption>
          {% endif %}
        </figure>
        </div>
      </section>
      <section data-case-study-panel>
        <div class="dialog-content-rail">
        {{ contextPanels(study.challengePanels) }}
        </div>
      </section>
      <section data-case-study-panel>
        <div class="dialog-content-rail">
        {{ productWorkflow(study.editorTitle, study.workflowSteps, study.workflowLabel, study.workflow) }}
        <p class="project-case-study-summary">{{ study.technicalContext }}</p>
        </div>
      </section>
      <section data-case-study-panel>
        <div class="dialog-content-rail">
        {% set experienceStack = {
          key: "drime-editor-case-study",
          groups: [
            study.stackPanels[0].groups[0], study.stackPanels[1].groups[0],
            study.stackPanels[0].groups[1], study.stackPanels[1].groups[1],
            study.stackPanels[0].groups[2], study.stackPanels[1].groups[2]
          ]
        } %}
        {% include "components/experience-stack.njk" %}
        <p class="project-case-study-summary">{{ study.stackSummary }}</p>
        </div>
      </section>
      <section data-case-study-panel>
        <div class="dialog-content-rail">
        {{ resultSummary(study.outcomes, study.conclusion) }}
        </div>
      </section>
{% endcall %}
