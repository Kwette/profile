<section data-dialog-view="demos" class="experience-demos" data-demo-gallery>
  <figure class="experience-demo-player" data-demo-player hidden>
    <button class="experience-demo-close" type="button" data-demo-close>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      <span>{{ experiences.demos.drime.closeLabel }}</span>
    </button>
    <video controls preload="metadata" data-demo-video></video>
  </figure>
  <div class="experience-demo-grid">
{% for demo in experiences.demos.drime.items %}
    <article class="experience-demo-card">
      <button class="experience-demo-card__media" type="button"
        aria-label="{{ experiences.demos.drime.actionLabel }} : {{ demo.title }}"
        data-demo-source="{{ demo.src }}"
        data-demo-poster="{{ demo.poster }}"
        data-demo-label="{{ demo.playerLabel }}">
        <img src="{{ demo.poster }}" alt="{{ demo.alt }}" width="1280" height="720" loading="lazy">
        <span class="experience-demo-play" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
        <span class="experience-demo-duration">{{ demo.duration }}</span>
      </button>
      <div class="experience-demo-card__body">
        <h3>{{ demo.title }}</h3>
        <p>{{ demo.description }}</p>
        <div class="experience-demo-card__footer">
          <button class="experience-demo-action" type="button"
            aria-label="{{ experiences.demos.drime.actionLabel }} : {{ demo.title }}"
            data-demo-source="{{ demo.src }}"
            data-demo-poster="{{ demo.poster }}"
            data-demo-label="{{ demo.playerLabel }}">
            {{ experiences.demos.drime.actionLabel }}
          </button>
        </div>
      </div>
    </article>
{% endfor %}
  </div>
</section>
