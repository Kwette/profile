      <section class="card selected-work" id="apps" aria-labelledby="selected-work-title-{{ language }}">
        <header class="selected-work-header text-center">
          <h2 id="selected-work-title-{{ language }}">{{ selectedWork.title }}</h2>
          <p>{{ selectedWork.intro }}</p>
        </header>
        <div class="selected-work-grid">
          <article class="project-card selected-project selected-project-featured case-study-trigger" id="{{ selectedWork.featured.id }}" role="button" tabindex="0" data-case-study-trigger aria-haspopup="dialog" aria-controls="drime-editor-case-study-{{ language }}" aria-label="{{ selectedWork.featured.caseStudy.actionLabel }}">
            <div class="project-card__media selected-project-media">
              <img src="{{ selectedWork.featured.image.src }}" width="{{ selectedWork.featured.image.width }}" height="{{ selectedWork.featured.image.height }}" loading="lazy" alt="{{ selectedWork.featured.image.alt }}">
            </div>
            <div class="project-card__content selected-project-content">
              <p class="project-card__eyebrow selected-project-label">{{ selectedWork.featured.label }}</p>
              <h3 class="project-card__title">{{ selectedWork.featured.title }}</h3>
              <p class="project-card__description selected-project-description">{{ selectedWork.featured.description }}</p>
              <p class="project-card__stack selected-project-stack">{{ selectedWork.featured.stack }}</p>
              <span class="project-card__action selected-project-link" aria-hidden="true">{{ selectedWork.featured.link.label }}</span>
            </div>
          </article>
          <div class="selected-project-secondary-grid">
            {% for project in selectedWork.secondary %}
            <article class="project-card selected-project selected-project-secondary selected-project-{{ project.modifier }}" id="{{ project.id }}">
              <div class="project-card__media selected-project-media">
                <img src="{{ project.image.src }}" width="{{ project.image.width }}" height="{{ project.image.height }}" loading="lazy" alt="{{ project.image.alt }}">
              </div>
              <div class="project-card__content selected-project-content">
                <p class="project-card__eyebrow selected-project-label">{{ project.label }}</p>
                <h3 class="project-card__title">{{ project.title }}</h3>
                <p class="project-card__description selected-project-description">{{ project.description }}</p>
                <p class="project-card__stack selected-project-stack">{{ project.stack }}</p>
                <a class="project-card__action selected-project-link" href="{{ project.link.href }}"{% if project.link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ project.link.label }}</a>
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>
{% include "components/project-case-study.njk" %}
