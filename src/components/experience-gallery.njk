<figure class="project-case-study-media experience-gallery-media{% if experienceGalleryModifier %} {{ experienceGalleryModifier }}{% endif %}"{% if not experienceGalleryEmbedded %} data-dialog-view="{{ experienceGallery.view }}"{% endif %}>
