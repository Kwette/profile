{% macro projectEntry(variant, type, name, metadata, date, summaryHref, summaryLabel, logoSrc, stack, githubHref="", behanceHref="", screenshotsLabel="Screenshots", summaryKind="site", summaryStack="") %}
<div class="one-project {{ variant }}" data-project-type="{{ type }}" data-project-name="{{ name }}" data-project-metadata="{{ metadata }}" data-project-date="{{ date }}" data-project-stack="{{ stack }}" data-project-summary-stack="{{ summaryStack or stack }}">
  <h2 class="project-name">{{ type }} | {{ name }}
    <span class="button" aria-hidden="true"><i class="fa-solid fa-plus" aria-hidden="true"></i></span>
  </h2>
  <div class="shadow-box">
    <div class="card-left-side">
      <h4>{{ metadata }}{% if date %} ({{ date }}){% endif %}</h4>
      <a href="{{ summaryHref }}" target="_blank" rel="noopener noreferrer" data-archive-link-kind="{{ summaryKind }}"><h4>{{ summaryLabel }}</h4></a>
    </div>
    <div class="card-right-side"><img src="{{ logoSrc }}" alt=""></div>
  </div>
  <div class="app-details hidden">
    {{ caller() }}
    <div class="purple-bg">
      <span class="bold">{{ stack }}</span>
    </div>
    {% if githubHref or behanceHref %}
    <div class="app-links">
      {% if githubHref %}
      <a href="{{ githubHref }}" target="_blank" rel="noopener noreferrer" data-archive-link-kind="code">
        <h4>
          <i class="fab fa-github-square"></i>
          <span>Github</span>
        </h4>
      </a>
      {% endif %}
      {% if behanceHref %}
      <a href="{{ behanceHref }}" target="_blank" rel="noopener noreferrer" data-archive-link-kind="captures">
        <h4>
          <i class="fab fa-behance-square"></i>
          <span>{{ screenshotsLabel }}</span>
        </h4>
      </a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>
{% endmacro %}
