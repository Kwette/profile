{% macro projectEntry(variant, title, metadata, summaryHref, summaryLabel, logoSrc, stack, githubHref="", behanceHref="", screenshotsLabel="Screenshots") %}
<div class="one-project {{ variant }}">
  <h2 class="project-name">{{ title }}
    <span>
      <div class="button"><i class="fa-solid fa-plus"></i></div>
    </span>
  </h2>
  <div class="shadow-box">
    <div class="card-left-side">
      <h4>{{ metadata }}</h4>
      <a href="{{ summaryHref }}" target="_blank" rel="noopener noreferrer"><h4>{{ summaryLabel }}</h4></a>
    </div>
    <div class="card-right-side"><img src="{{ logoSrc }}" alt=""></div>
  </div>
  <div class="app-details hidden">
    {{ caller() }}
    <div class="purple-bg">
      <span class="bold">{{ stack }}</span>
    </div>
    {% if githubHref or behanceHref %}
    <div class="app-links">
      {% if githubHref %}
      <a href="{{ githubHref }}" target="_blank" rel="noopener noreferrer">
        <h4>
          <i class="fab fa-github-square"></i>
          <span>Github</span>
        </h4>
      </a>
      {% endif %}
      {% if behanceHref %}
      <a href="{{ behanceHref }}" target="_blank" rel="noopener noreferrer">
        <h4>
          <i class="fab fa-behance-square"></i>
          <span>{{ screenshotsLabel }}</span>
        </h4>
      </a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>
{% endmacro %}
