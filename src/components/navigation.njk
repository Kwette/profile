    <div class="site-nav">
      <div class="site-nav-content">
        <a href="#" class="site-brand" aria-label="{{ navigation.brandLabel }}">EMZ</a>
        <nav class="site-nav-links" id="site-nav-links-{{ language }}" aria-label="{{ navigation.ariaLabel }}">
          {% for item in navigation.items %}
          <a href="{{ item.href }}"{% if item.className %} class="{{ item.className }}"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </nav>
        <div class="site-nav-actions">
          <a href="#resume">{{ navigation.resumeLabel }}</a>
          <div class="language-switcher" aria-label="{{ navigation.languageLabel }}">
            {% for item in navigation.languages %}
              {% if not loop.first %}<span aria-hidden="true">|</span>{% endif %}
              {% if item.current %}<span aria-current="page">{{ item.label }}</span>{% else %}<a href="{{ item.href }}" hreflang="{{ item.hreflang }}">{{ item.label }}</a>{% endif %}
            {% endfor %}
          </div>
        </div>
        <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav-links-{{ language }}" aria-label="{{ navigation.menuOpenLabel }}" data-open-label="{{ navigation.menuOpenLabel }}" data-close-label="{{ navigation.menuCloseLabel }}"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
      </div>
    </div>
    <button class="button back-to-top" type="button" data-back-to-top aria-label="{{ navigation.backToTopLabel }}" aria-hidden="true" tabindex="-1"><i class="fa-solid fa-arrow-up"></i></button>
