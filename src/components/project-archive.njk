<button class="project-archive-toggle" type="button" aria-expanded="false" aria-controls="project-archive-{{ language }}" data-open-label="{{ projectArchive.action }}" data-close-label="{{ projectArchive.closeAction }}">
  <span class="project-archive-action">{{ projectArchive.action }}</span>
  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
</button>
<div class="project-archive-items" id="project-archive-{{ language }}" data-dialog-close-label="{{ projectArchive.closeLabel }}" data-details-label="{{ projectArchive.detailsLabel }}" data-code-label="{{ projectArchive.linkLabels.code }}" data-captures-label="{{ projectArchive.linkLabels.captures }}" data-site-label="{{ projectArchive.linkLabels.site }}">
  <div class="community-heading">
    <h3>{{ projectArchive.communityTitle }}</h3>
    <p>{{ projectArchive.communityDescription }}</p>
  </div>
{% include projectArchive.contentTemplate %}
</div>
