{% from "components/info-tags.njk" import infoTags %}
          <button class="experience-card__trigger experience-summary" type="button" aria-expanded="false" aria-controls="experience-{{ experienceSummary.key }}-{{ language }}">
            <span class="experience-card__brand experience-company"><span class="experience-card__logo experience-logo{% if experienceSummary.logo.className %} {{ experienceSummary.logo.className }}{% endif %}"><img src="{{ experienceSummary.logo.src }}" alt="{{ experienceSummary.logo.alt }}"></span></span>
            <span class="experience-card__content experience-summary-content">
              <span class="experience-card__title experience-role">{{ experienceSummary.role }}</span>
              <span class="experience-card__meta experience-meta">{{ experienceSummary.meta }}</span>
              <span class="experience-card__description">{{ experienceSummary.description }}</span>
              {{ infoTags(experienceSummary.keywords, "", true) }}
            </span>
            <span class="experience-card__action experience-chevron"><span>{{ experiences.viewLabel }}</span></span>
          </button>
